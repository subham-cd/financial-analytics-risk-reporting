# FinSight Platform - Environment Configuration Template
# Copy this file to .env and configure secrets accordingly.

APP_NAME=FinSight
APP_ENV=production
DEBUG=False
PORT=8000
HOST=127.0.0.1

# Database Configuration (PostgreSQL / SQLite)
DATABASE_ENGINE=sqlite
DATABASE_URL=sqlite:///./finsight.db

# If using PostgreSQL:
# DATABASE_ENGINE=postgresql
# POSTGRES_USER=finsight_admin
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=finsight_db

# Security & API Keys
API_SECRET_KEY=change_this_to_a_random_32_character_string
CORS_ORIGINS=["*"]

# Machine Learning Artifacts
MODEL_VERSION=v1.0.0-logistic-woe
SCORECARD_BASE_SCORE=650
SCORECARD_BASE_ODDS=20.0
SCORECARD_PDO=20.0

# Power Automate Integration
POWER_AUTOMATE_RECIPIENTS=cfo@company.com,board@company.com
